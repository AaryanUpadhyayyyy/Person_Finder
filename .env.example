# Wallet private key (Hardhat account #0 shown — NEVER use on mainnet)
ETH_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed contract address (auto-filled by deploy_contract.py)
CONTRACT_ADDRESS=

